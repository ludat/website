---
import { getEntry, render } from 'astro:content';
import { audienceIds, audienceLabel, currentAudience, FULL } from '../../../cv/audiences';
import { languages } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';
import CvLayout from '../../../layouts/CvLayout.astro';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((locale) => [
    // /{locale}/cv/ — the full CV
    { params: { locale, audience: undefined } },
    // /{locale}/cv/{audience}/ — one focused variant per audience
    ...audienceIds.map((audience) => ({ params: { locale, audience } })),
  ]);
}

const locale = Astro.currentLocale as Lang;
const audience = currentAudience(Astro.params);
const page = await getEntry('pages', `cv/${locale}`)!;
const { Content } = await render(page);

const suffix = audience === FULL ? '' : ` (${audienceLabel(audience, locale)})`;
---

<CvLayout
  title={`${page.data.title}${suffix} - Ludat`}
  description={page.data.description}
>
  <Content />
</CvLayout>
